---
// The About text lives in src/data/about.md (plain Markdown), so it's easy to edit on GitHub.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import EmailLink from "../components/EmailLink.astro";
import { Content as AboutText } from "../data/about.md";
import headshot from "../assets/headshot.jpg";
import { profile } from "../lib/content";
---
<Base title="About" description={`About ${profile.name}: radar meteorology, drop size distributions, Mei-Yu fronts and open-source radar software.`}>
  <header class="page-head"><h1>About</h1></header>
  <div class="about">
    <div class="prose"><AboutText /></div>
    <aside class="about-card" id="contact" aria-label="Contact">
      <Image src={headshot} alt="Ian Cornejo" widths={[144, 288]} sizes="144px" />
      <dl>
        <div><dt>Email</dt><dd><EmailLink /></dd></div>
        <div><dt>Office</dt><dd>{profile.office}</dd></div>
        <div><dt>ORCID</dt><dd><a href={`https://orcid.org/${profile.orcid}`}>{profile.orcid}</a></dd></div>
        <div><dt>GitHub</dt><dd><a href={`https://github.com/${profile.github}`}>{profile.github}</a></dd></div>
        <div><dt>CV</dt><dd><a href="/cv/">Full CV</a></dd></div>
      </dl>
    </aside>
  </div>
</Base>
