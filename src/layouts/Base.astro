---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../lib/content";

interface Props { title?: string; description?: string }
const {
  title,
  description = `${profile.name}, ${profile.position} at ${profile.institution}: radar meteorology, drop size distributions and precipitation microphysics.`,
} = Astro.props;
const fullTitle = title ? `${title} · ${profile.short_name}` : `${profile.short_name} · ${profile.eyebrow}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const token = profile.site.cloudflare_analytics_token;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/geom-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F3ECDE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.short_name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.short_name}: ${profile.eyebrow}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container"><slot /></main>
    <Footer />
    <script is:inline>
      (function () {
        // Remove "New!" and "Upcoming" tags whose date has passed (they lapse between rebuilds).
        var now = Date.now();
        document.querySelectorAll("[data-until]").forEach(function (el) {
          if (Date.parse(el.getAttribute("data-until") + "T23:59:59Z") < now) el.remove();
        });
        // Assemble email links (D19).
        document.querySelectorAll("a[data-u][data-d]").forEach(function (a) {
          var e = a.getAttribute("data-u") + "@" + a.getAttribute("data-d");
          a.href = "mailto:" + e;
          if (a.hasAttribute("data-show")) a.textContent = e;
        });
      })();
    </script>
    {token && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token })}></script>
    )}
  </body>
</html>
